# =============================================================================
# FRONTEND ENV VARIABLES  (Next.js)
# Add these ONE BY ONE in Vercel -> Project Settings -> Environment Variables
# Tick: Production, Preview, Development. Never commit the real .env file.
# =============================================================================

# Must be your DEPLOYED frontend URL (used by BetterAuth + Stripe callbacks).
# e.g. https://tuitora-frontend.vercel.app
BETTER_AUTH_URL=https://<your-frontend>.vercel.app

# Same MongoDB Atlas URI as the backend (frontend has its own API routes).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Must MATCH the backend's JWT_SECRET / BETTER_AUTH_SECRET exactly.
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
JWT_SECRET=replace_with_a_long_random_secret

# Google OAuth - callback URL must be updated in Google Cloud Console to:
# https://<your-frontend>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Deployed Express backend URL (optional: browse falls back to local MongoDB
# automatically if this is unreachable). No trailing slash.
BACKEND_API_URL=https://<your-backend>.vercel.app
NEXT_PUBLIC_BASE_URL=https://<your-backend>.vercel.app

# ImgBB (used by /api/upload)
IMAGEBB_API_KEY=your_imgbb_api_key

# Stripe (webhook endpoint must point to:
# https://<your-frontend>.vercel.app/api/stripe/webhook)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
