# =============================================================================
# FRONTEND ENV VARIABLES (Next.js)
# Copy to .env for local development. On Vercel, add these ONE BY ONE in
# Project Settings -> Environment Variables (Production, Preview, Development).
# Never commit the real .env file.
# =============================================================================

# Public origin of THIS frontend. BetterAuth uses it to build OAuth callbacks.
# Local:  http://localhost:3000
# Vercel: https://<your-frontend>.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Optional override for the browser auth client. Leave UNSET (recommended): the
# client then uses the origin the page is served from, which also works for
# Vercel preview deployments. Only set it when the public auth origin differs.
# NEXT_PUBLIC_BETTER_AUTH_URL=https://<your-public-origin>

# Must be the SAME MongoDB Atlas URI and secret as the backend.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
JWT_SECRET=replace_with_a_long_random_secret

# Google OAuth. The callback URL registered in Google Cloud Console MUST be:
#   http://localhost:3000/api/auth/callback/google          (local)
#   https://<your-frontend>.vercel.app/api/auth/callback/google  (deployed)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Express backend (optional: browse falls back to local MongoDB if unreachable).
BACKEND_API_URL=http://localhost:5000
NEXT_PUBLIC_BASE_URL=http://localhost:5000

# ImgBB (used by /api/upload)
IMAGEBB_API_KEY=your_imgbb_api_key

# Stripe (webhook endpoint must point to:
#   https://<your-frontend>.vercel.app/api/stripe/webhook)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
